<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".OrderSaveActivity">

    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:orientation="vertical">

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@android:color/black" />

        <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="№"
            android:paddingLeft="9dp"
            android:textColor="@color/black"
            android:layout_weight="0.20"/>
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@android:color/black"/>
        <EditText
            android:id="@+id/id"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:paddingLeft="9dp"
            android:textColor="@color/black"
            android:layout_weight="0.75"
            android:enabled="false"/>

    </LinearLayout>
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@android:color/black"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Дата"
            android:paddingLeft="9dp"
            android:textColor="@color/black"
            android:layout_weight="0.20"/>
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@android:color/black"/>
        <EditText
            android:id="@+id/data"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:paddingLeft="9dp"
            android:textColor="@color/black"
            android:layout_weight="0.75"
            android:enabled="false"/>
    </LinearLayout>
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@android:color/black"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Заказ"
            android:paddingLeft="9dp"
            android:textColor="@color/black"
            android:layout_weight="0.20"/>
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@android:color/black"/>

        <Spinner
            android:id="@+id/spinner_product"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.75"
            android:paddingLeft="9dp" />

    </LinearLayout>
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@android:color/black"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Файл"
            android:paddingLeft="9dp"
            android:textColor="@color/black"
            android:layout_weight="0.20"
            android:layout_gravity="center"/>
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@android:color/black"/>
        <EditText
            android:id="@+id/image"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:paddingLeft="9dp"
            android:textColor="@color/black"
            android:layout_weight="0.75"
            android:enabled="false">
        </EditText>
    </LinearLayout>
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@android:color/black"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Длина"
            android:paddingLeft="9dp"
            android:textColor="@color/black"
            android:layout_weight="0.20"/>
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@android:color/black"/>
        <EditText
            android:id="@+id/dlina"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:paddingLeft="9dp"
            android:textColor="@color/black"
            android:layout_weight="0.75" >
        </EditText>
    </LinearLayout>
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@android:color/black"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Ширина"
            android:paddingLeft="9dp"
            android:textColor="@color/black"
            android:layout_weight="0.20"/>
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@android:color/black"/>
        <EditText
            android:id="@+id/shirina"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:paddingLeft="9dp"
            android:textColor="@color/black"
            android:layout_weight="0.75" >
        </EditText>
    </LinearLayout>
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@android:color/black"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Высота"
            android:paddingLeft="9dp"
            android:textColor="@color/black"
            android:layout_weight="0.20"/>
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@android:color/black"/>
        <EditText
            android:id="@+id/visota"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:paddingLeft="9dp"
            android:textColor="@color/black"
            android:layout_weight="0.75" >
        </EditText>
    </LinearLayout>
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@android:color/black"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Сумма"
            android:paddingLeft="9dp"
            android:textColor="@color/black"
            android:layout_weight="0.20"/>
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@android:color/black"/>
        <EditText
            android:id="@+id/prise"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:paddingLeft="9dp"
            android:textColor="@color/black"
            android:layout_weight="0.75"
            android:inputType="number"/>
    </LinearLayout>
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@android:color/black"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Оплата"
            android:paddingLeft="9dp"
            android:textColor="@color/black"
            android:layout_weight="0.20"/>
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@android:color/black"/>
        <EditText
            android:id="@+id/pay"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:paddingLeft="9dp"
            android:textColor="@color/black"
            android:layout_weight="0.75"
            android:inputType="number"/>
    </LinearLayout>
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@android:color/black"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Процесс"
            android:paddingLeft="9dp"
            android:textColor="@color/black"
            android:layout_weight="0.20"/>
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@android:color/black"/>
        <EditText
            android:id="@+id/proces"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:paddingLeft="9dp"
            android:textColor="@color/black"
            android:layout_weight="0.75" >
        </EditText>
    </LinearLayout>
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@android:color/black"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Имя"
            android:paddingLeft="9dp"
            android:textColor="@color/black"
            android:layout_weight="0.20"/>
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@android:color/black"/>
        <EditText
            android:id="@+id/name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:paddingLeft="9dp"
            android:textColor="@color/black"
            android:layout_weight="0.75" >
        </EditText>
    </LinearLayout>
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@android:color/black"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Телефон"
            android:paddingLeft="9dp"
            android:textColor="@color/black"
            android:layout_weight="0.20"/>

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@android:color/black" />
        <EditText
            android:id="@+id/tel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:paddingLeft="9dp"
            android:textColor="@color/black"
            android:layout_weight="0.75"
            android:inputType="phone"/>
    </LinearLayout>
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@android:color/black"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Email"
            android:paddingLeft="9dp"
            android:textColor="@color/black"
            android:layout_weight="0.20"/>
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@android:color/black"/>
        <EditText
            android:id="@+id/email"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:paddingLeft="9dp"
            android:textColor="@color/black"
            android:layout_weight="0.75" />
    </LinearLayout>
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@android:color/black"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Прочее"
            android:paddingLeft="9dp"
            android:textColor="@color/black"
            android:layout_weight="0.20"/>
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@android:color/black"/>
        <EditText
            android:id="@+id/coment"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:paddingLeft="9dp"
            android:textColor="@color/black"
            android:layout_weight="0.75" >
        </EditText>
    </LinearLayout>
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@android:color/black"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="400dp"
            android:orientation="horizontal">
            <WebView
                android:id="@+id/webBrowser"
                android:layout_width="match_parent"
                android:layout_height="400dp"/>
        </LinearLayout>

    </LinearLayout>

</ScrollView>